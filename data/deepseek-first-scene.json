        },
        {
          "at": 17.6,
          "type": "expression",
          "actor": "granny",
          "value": "thinking"
        }
      ],
      "memory": "狗儿当众问刘姥姥家中过冬无着落还能寻哪条路；刘姥姥答路是人走出来的，劝先别愁。"
    },
    {
      "id": "second",
      "title": "低声商量",
      "duration": 24,
      "narration": "狗儿走到屋中右后侧，刘氏走到母亲近旁。两人停下脚步后，刘氏压低了声音。",
      "dialogue": [
        {
          "at": 6,
          "until": 19,
          "speaker": "liushi",
          "to": [
            "granny"
          ],
          "mode": "whisper",
          "text": "娘，您可认识什么人，能替咱们递句话？",
          "knowledgeRefs": []
        }
      ],
      "commands": [
        {
